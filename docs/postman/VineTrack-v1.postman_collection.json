{
 "info": {
  "name": "VineTrack API v1",
  "description": "VineTrack integration API — reads across all modules plus Stage 8 writes (work tasks, fuel, irrigation, growth stages, yield). POST requests need an Idempotency-Key header (pre-filled with {{$guid}}); PATCH requests need expected_updated_at from your latest GET. Set the collection variables `vinetrack_api_host` (e.g. https://YOUR-PROJECT.supabase.co/functions/v1/vinetrack-api) and `vinetrack_api_key` (vt_live_... or vt_test_... — never commit real keys). Most collection requests also need `vineyard_id` (take one from GET /v1/vineyards). Docs: docs/vinetrack-developer-platform.md",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{vinetrack_api_key}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "vinetrack_api_host",
   "value": "https://YOUR-PROJECT.supabase.co/functions/v1/vinetrack-api"
  },
  {
   "key": "vinetrack_api_key",
   "value": "vt_test_REPLACE_ME"
  },
  {
   "key": "vineyard_id",
   "value": "00000000-0000-4000-8000-000000000001"
  }
 ],
 "item": [
  {
   "name": "Core",
   "item": [
    {
     "name": "GET /v1/me",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/me",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "me"
       ]
      },
      "description": "Confirms authentication and lists granted scopes and vineyards. Requires a valid key but no resource scope."
     }
    },
    {
     "name": "GET /v1/vineyards",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/vineyards?limit=100",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "vineyards"
       ],
       "query": [
        {
         "key": "limit",
         "value": "100"
        }
       ]
      },
      "description": "Requires vineyards:read. Returns only explicitly granted vineyards."
     }
    },
    {
     "name": "GET /v1/blocks",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/blocks?vineyard_id={{vineyard_id}}",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "blocks"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        }
       ]
      },
      "description": "Requires blocks:read. vineyard_id is required."
     }
    }
   ]
  },
  {
   "name": "Operations",
   "item": [
    {
     "name": "GET /v1/trips",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/trips?vineyard_id={{vineyard_id}}&limit=25",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "trips"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        },
        {
         "key": "limit",
         "value": "25"
        },
        {
         "key": "from",
         "value": "2026-01-01",
         "disabled": true
        },
        {
         "key": "to",
         "value": "2026-12-31",
         "disabled": true
        },
        {
         "key": "equipment_id",
         "value": "",
         "disabled": true
        }
       ]
      },
      "description": "Requires trips:read. operator appears only with labour:read."
     }
    },
    {
     "name": "GET /v1/spray-jobs",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/spray-jobs?vineyard_id={{vineyard_id}}&limit=25",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "spray-jobs"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        },
        {
         "key": "limit",
         "value": "25"
        }
       ]
      },
      "description": "Requires sprays:read. Product costs appear only with costs:read."
     }
    },
    {
     "name": "GET /v1/fuel-records",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/fuel-records?vineyard_id={{vineyard_id}}&limit=25",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "fuel-records"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        },
        {
         "key": "limit",
         "value": "25"
        }
       ]
      },
      "description": "Requires fuel:read. Costs gated by costs:read; operator by labour:read."
     }
    },
    {
     "name": "GET /v1/fuel-purchases",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/fuel-purchases?vineyard_id={{vineyard_id}}&limit=25",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "fuel-purchases"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        },
        {
         "key": "limit",
         "value": "25"
        }
       ]
      },
      "description": "Requires fuel:read. Prices appear only with costs:read."
     }
    },
    {
     "name": "GET /v1/equipment",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/equipment?vineyard_id={{vineyard_id}}",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "equipment"
       ],
       "query": [
        {
         "key": "vineyard_id",
         "value": "{{vineyard_id}}"
        },
        {
         "key": "type",
         "value": "machine",
         "disabled": true
        }
       ]
      },
      "description": "Requires equipment:read. type: machine|sprayer|item or a machine subtype."
     }
    }
   ]
  },
