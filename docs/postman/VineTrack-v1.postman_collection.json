      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"vineyard_id\": \"{{vineyard_id}}\",\n  \"date\": \"2026-01-15T07:30:00Z\",\n  \"volume_l\": 55.5,\n  \"equipment_id\": \"00000000-0000-4000-8000-000000000003\",\n  \"engine_hours\": 1204.5,\n  \"filled_to_full\": true,\n  \"external_id\": \"example-fuel-1\"\n}",
       "options": {
        "raw": {
