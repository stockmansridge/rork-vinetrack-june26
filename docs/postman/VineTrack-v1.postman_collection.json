  },
  {
   "name": "Writes (Stage 8)",
   "description": "Requires the matching *:write scope + vineyard grant. POST = create (Idempotency-Key required, 201). PATCH = partial update (expected_updated_at required, 200; 409 conflict when stale). Synthetic example data only.",
   "item": [
    {
     "name": "POST /v1/work-tasks",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Idempotency-Key",
        "value": "{{$guid}}",
        "description": "Required on every POST. Reuse the SAME key when retrying the SAME request; a new key for each new logical operation."
       }
      ],
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/work-tasks",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "work-tasks"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"vineyard_id\": \"{{vineyard_id}}\",\n  \"task_type\": \"Slashing\",\n  \"date\": \"2026-01-15T09:00:00Z\",\n  \"status\": \"planned\",\n  \"notes\": \"Mid-row slashing, north end first\",\n  \"block_ids\": [\n    \"00000000-0000-4000-8000-000000000002\"\n  ],\n  \"external_id\": \"example-task-100\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "description": "Scope: work_tasks:write. Creates a work task; blocks must belong to the vineyard. Returns 201 with the canonical representation. Replaying with the same Idempotency-Key + payload returns the original record (Idempotency-Replayed: true)."
     }
    },
    {
     "name": "PATCH /v1/work-tasks/{work_task_id}",
     "request": {
      "method": "PATCH",
      "url": {
       "raw": "{{vinetrack_api_host}}/v1/work-tasks/REPLACE_WITH_WORK_TASK_ID",
       "host": [
        "{{vinetrack_api_host}}"
       ],
       "path": [
        "v1",
        "work-tasks",
        "REPLACE_WITH_WORK_TASK_ID"
       ]
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"expected_updated_at\": \"REPLACE_WITH_UPDATED_AT_FROM_GET\",\n  \"status\": \"in_progress\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "description": "Scope: work_tasks:write. Partial update — omitted fields unchanged, null clears nullable fields. expected_updated_at is the updated_at from your latest GET (409 conflict on mismatch). Finalised/archived tasks refuse edits."
     }
    },
    {
     "name": "POST /v1/fuel-records",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Idempotency-Key",
        "value": "{{$guid}}",
        "description": "Required on every POST. Reuse the SAME key when retrying the SAME request; a new key for each new logical operation."
       }
