+          "definition": "CREATE OR REPLACE FUNCTION public.cancel_trip_activity_v1(p_operation_id uuid, p_trip_id uuid, p_vineyard_id uuid, p_application text, p_client_baseline jsonb DEFAULT '{}'::jsonb, p_compliance_facts jsonb DEFAULT NULL::jsonb)\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\ndeclare\n  v_uid uuid := auth.uid(); v_role text; v_trip public.trips;\n  v_existing public.trip_activity_cancellation_receipts; v_receipt public.trip_activity_cancellation_receipts;\n  v_spray uuid[]; v_archive uuid; n_actuals integer := 0; n_spray integer := 0; n_cost integer := 0;\nbegin\n  if v_uid is null then raise exception 'TRIP_CANCEL_AUTH_REQUIRED' using errcode = '42501'; end if;\n  if p_operation_id is null or p_trip_id is null or p_vineyard_id is null then raise exception 'TRIP_CANCEL_INVALID_IDENTITY' using errcode = '22023'; end if;\n  if p_application is null or p_application not in ('not_applied', 'applied') then raise exception 'TRIP_CANCEL_CLASSIFICATION_REQUIRED' using errcode = '22023'; end if;\n  if p_client_baseline is null or jsonb_typeof(p_client_baseline) <> 'object' then raise exception 'TRIP_CANCEL_INVALID_BASELINE' using errcode = '22023'; end if;\n  v_role := public.vineyard_role(p_vineyard_id);\n  if v_role is null or v_role not in ('owner', 'manager', 'supervisor') then raise exception 'TRIP_CANCEL_FORBIDDEN' using errcode = '42501'; end if;\n  select * into v_existing from public.trip_activity_cancellation_receipts where operation_id = p_operation_id;\n  if found then\n    if v_existing.trip_id <> p_trip_id or v_existing.vineyard_id <> p_vineyard_id or v_existing.application_classification <> p_application then raise exception 'TRIP_CANCEL_OPERATION_CONFLICT' using errcode = '23505'; end if;\n    return public.trip_cancellation_receipt_json_v1(v_existing) || jsonb_build_object('replayed', true);\n  end if;\n  if exists (select 1 from public.trip_activity_cancellation_receipts where trip_id = p_trip_id) then raise exception 'TRIP_CANCEL_ALREADY_CANCELLED_OTHER_OPERATION' using errcode = '23505'; end if;\n  select * into v_trip from public.trips where id = p_trip_id for update;\n  if not found or v_trip.vineyard_id <> p_vineyard_id then raise exception 'TRIP_CANCEL_TRIP_NOT_FOUND' using errcode = 'P0002'; end if;\n  if v_trip.deleted_at is not null then raise exception 'TRIP_CANCEL_TRIP_ALREADY_DELETED' using errcode = '55000'; end if;\n  if v_trip.end_time is not null then raise exception 'TRIP_CANCEL_TRIP_COMPLETED' using errcode = '55000'; end if;\n  if coalesce(v_trip.entry_source, '') = 'manual' then raise exception 'TRIP_CANCEL_MANUAL_ENTRY_UNSUPPORTED' using errcode = '0A000'; end if;\n  select coalesce(array_agg(id order by id), '{}') into v_spray from public.spray_records where trip_id = p_trip_id and vineyard_id = p_vineyard_id and deleted_at is null;\n  if exists (select 1 from public.spray_records where id = any (v_spray) and coalesce(entry_source, '') = 'manual') then raise exception 'TRIP_CANCEL_MANUAL_ENTRY_UNSUPPORTED' using errcode = '0A000'; end if;\n  if p_application = 'not_applied' then\n    if exists (select 1 from public.spray_tank_actuals where trip_id = p_trip_id and deleted_at is null) then raise exception 'TRIP_CANCEL_SERVER_ACTUALS_REQUIRE_APPLIED_REVIEW' using errcode = '55000'; end if;\n  else\n    if p_compliance_facts is null or jsonb_typeof(p_compliance_facts) <> 'object' or p_compliance_facts = '{}'::jsonb then raise exception 'TRIP_CANCEL_COMPLIANCE_FACTS_REQUIRED' using errcode = '22023'; end if;\n    insert into public.trip_compliance_archive (operation_id, trip_id, vineyard_id, source, facts, retain_until, created_by)\n    values (p_operation_id, p_trip_id, p_vineyard_id, 'applied_trip_cancellation', jsonb_build_object('client_application_facts', p_compliance_facts, 'server_trip', to_jsonb(v_trip), 'server_spray_records', coalesce((select jsonb_agg(to_jsonb(s)) from public.spray_records s where s.id = any (v_spray)), '[]'::jsonb), 'server_tank_actuals', coalesce((select jsonb_agg(to_jsonb(a)) from public.spray_tank_actuals a where a.trip_id = p_trip_id and a.deleted_at is null), '[]'::jsonb), 'actor_user_id', v_uid, 'actor_role', v_role, 'archived_at', now()), (now() + interval '3 years')::date, v_uid)\n    returning id into v_archive;\n  end if;\n  update public.spray_tank_actuals set deleted_at = now() where trip_id = p_trip_id and deleted_at is null;\n  get diagnostics n_actuals = row_count;\n  update public.trip_cost_allocations set deleted_at = now(), updated_by = v_uid where trip_id = p_trip_id and deleted_at is null;\n  get diagnostics n_cost = row_count;\n  update public.spray_records set deleted_at = now(), updated_by = v_uid where id = any (v_spray) and deleted_at is null;\n  get diagnostics n_spray = row_count;\n  update public.trips set deleted_at = now(), updated_by = v_uid where id = p_trip_id;\n  insert into public.trip_activity_cancellation_receipts (operation_id, trip_id, vineyard_id, actor_user_id, actor_role, application_classification, compliance_archive_id, spray_record_ids, removed_counts, client_baseline)\n  values (p_operation_id, p_trip_id, p_vineyard_id, v_uid, v_role, p_application, v_archive, v_spray, jsonb_build_object('trip', 1, 'spray_records', n_spray, 'spray_tank_actuals', n_actuals, 'trip_cost_allocations', n_cost), p_client_baseline)\n  returning * into v_receipt;\n  return public.trip_cancellation_receipt_json_v1(v_receipt) || jsonb_build_object('replayed', false);\nend $function$\n",
