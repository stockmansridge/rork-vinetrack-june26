+          "definition": "CREATE OR REPLACE FUNCTION public.guard_cancelled_trip_v1()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\ndeclare v_trip uuid;\nbegin\n  if tg_table_name = 'trips' then v_trip := new.id; else v_trip := new.trip_id; end if;\n  if (v_trip is not null and exists (select 1 from public.trip_activity_cancellation_receipts r where r.trip_id = v_trip))\n     or (tg_table_name = 'spray_records' and exists (select 1 from public.trip_activity_cancellation_receipts r where r.spray_record_ids @> array[new.id])) then\n    raise exception 'TRIP_CANCELLED_TOMBSTONE' using errcode = 'P0001', detail = 'This Trip was cancelled with a durable receipt. It cannot be recreated or changed.';\n  end if;\n  return new;\nend $function$\n",
